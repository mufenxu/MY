# Dependencies and build output
**/node_modules/
**/dist/
**/coverage/
**/output/
**/*.log

# Local agent and Codex logs
.agents/
.codex-logs/

# Temporary scratch directories (browser profiles, screenshots, one-off debug output)
# 已清理：npm run clean；根目录下所有 .tmp-* 都会被忽略并纳入清理范围
/.tmp-*/

# Agent scratch space；memory/ 与 artifacts/ 是项目资产，继续入库
/.workbuddy/tmp/

# Runtime data
**/data/
**/uploads/
**/*.sqlite
**/*.sqlite3
**/*.db

# Android source package, not runtime data
!apps/android-app/app/src/main/java/cn/pxyb/mycontrol/data/
!apps/android-app/app/src/main/java/cn/pxyb/mycontrol/data/**

# Local migration archive (kept outside the maintained repository)
/archive/
/backups/
/.deployment-runner/

# Secrets and local configuration
.env
/.env.ci
/.env.release-smoke
**/.env
**/env
**/*.local
**/project.private.config.json

# CI by-products that must never be committed
/release-artifacts.tsv
/changed-files.txt
/build-metadata-*.json
/blackbox-spool.jsonl

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
