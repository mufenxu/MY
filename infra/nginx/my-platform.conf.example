map $http_upgrade $connection_upgrade {
    default upgrade;
    '' '';
}

upstream my_platform_gateway {
    server 127.0.0.1:22100;
    keepalive 32;
}

# 主入口：一个域名承载统一登录、所有管理后台和规范化 API 路径。
server {
    listen 443 ssl;
    # nginx >= 1.25.1 的写法；更旧的版本请删掉本行并改用 `listen 443 ssl http2;`。
    http2 on;
    # 可选的 HTTP/3：需要 nginx 编译了 http_v3 模块并放行 UDP 443，按需取消注释。
    # 多 worker 时给其中一个站点的 quic 监听加 reuseport（全局只能出现一次）。
    # listen 443 quic;
    # http3 on;
    # add_header Alt-Svc 'h3=":443"; ma=86400' always;
    server_name pxyb.cn;
    server_tokens off;

    # 请按证书实际位置修改。
    ssl_certificate /etc/nginx/ssl/pxyb.cn/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/pxyb.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # 普通 API 请求保持较小的全局请求体上限；备份传输在下方单独放宽。
    client_max_body_size 32m;

    # 压缩文本类响应。官网、campus、iot、notification 自身不做压缩，靠这里统一处理；
    # 已压缩的备份流（application/gzip）不在列表内，不会被二次压缩。
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json
               application/manifest+json image/svg+xml text/calendar;

    # Raw gzip backup transfers use the same 5 GiB and 10 minute defaults as
    # PLATFORM_BACKUP_UPLOAD_MAX_BYTES and PLATFORM_BACKUP_TRANSFER_TIMEOUT_MS.
    location ^~ /api/backups/ {
        client_max_body_size 5g;
        client_body_timeout 600s;
        proxy_pass http://my_platform_gateway;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Android App Links 域名关联：文件由 admin-console 提供，网关上挂在 /console 下。
    location = /.well-known/assetlinks.json {
        proxy_pass http://my_platform_gateway/console/.well-known/assetlinks.json;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # OIDC Discovery（/.well-known/openid-configuration）由下面的 `location /` 直接转发给网关。
    # 如果证书工具在本机接管了 /.well-known 目录，需要为它单独加一个精确匹配的 location，
    # 写法见 pxyb.cn.baota.conf.example。
    location / {
        proxy_pass http://my_platform_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 覆盖客户端自带的 X-Forwarded-For，避免伪造来源地址绕过登录限流。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}

server {
    listen 80;
    server_name pxyb.cn;
    server_tokens off;
    return 308 https://$host$request_uri;
}
