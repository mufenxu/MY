{
  "schemaVersion": 1,
  "targets": {
    "platform": { "aliases": ["platform-api", "core", "core-api", "exam", "exam-api"], "dockerfile": "infra/docker/platform-api.Dockerfile", "context": ".", "tag": "platform-api-latest", "envKey": "PLATFORM_API_IMAGE" },
    "notification": { "aliases": ["notification-service"], "dockerfile": "infra/docker/notification-service.Dockerfile", "context": ".", "tag": "notification-service-latest", "envKey": "NOTIFICATION_SERVICE_IMAGE" },
    "backup": { "aliases": ["backup-runner"], "dockerfile": "infra/docker/backup-runner.Dockerfile", "context": ".", "tag": "backup-runner-latest", "envKey": "BACKUP_RUNNER_IMAGE" },
    "campus": { "aliases": ["campus-service"], "dockerfile": "infra/docker/campus-service.Dockerfile", "context": ".", "tag": "campus-service-latest", "envKey": "CAMPUS_SERVICE_IMAGE" },
    "iot": { "aliases": ["iot-service"], "dockerfile": "infra/docker/iot-service.Dockerfile", "context": ".", "tag": "iot-service-latest", "envKey": "IOT_SERVICE_IMAGE" },
    "mongodb": { "aliases": ["mongo"], "dockerfile": "infra/docker/mongodb.Dockerfile", "context": "infra/docker", "tag": "mongodb-7.0", "envKey": "MONGODB_IMAGE" }
  },
  "rules": [
    {
      "paths": [".github/workflows/aliyun-acr.yml", "config/image-build-targets.json", "scripts/resolve-image-targets.mjs", "scripts/buildx-metadata.mjs"],
      "targets": ["*"]
    },
    {
      "paths": ["infra/docker/platform-api.Dockerfile", "apps/admin-console/**", "apps/official-website/**", "config/platform.services.docker.json", "services/platform-api/**"],
      "targets": ["platform"]
    },
    {
      "paths": ["infra/docker/backup-runner.Dockerfile", "scripts/backup-runner.mjs", "scripts/backup-mongodb-container.mjs", "scripts/restore-mongodb-container.mjs", "apps/admin-console/package.json", "apps/admin-console/package-lock.json", "apps/admin-console/src/backups.js", "apps/admin-console/src/backupArchives.js", "apps/admin-console/src/backupStorage.js"],
      "targets": ["backup"]
    },
    {
      "paths": ["infra/docker/compose.yml", "infra/docker/compose.split.yml"],
      "targets": ["platform"]
    },
    {
      "paths": ["infra/docker/core-api.Dockerfile", "apps/core-admin/**", "services/core-api/**"],
      "targets": ["platform"]
    },
    {
      "paths": ["infra/docker/exam-api.Dockerfile", "apps/exam-admin/**", "services/exam-api/**"],
      "targets": ["platform"]
    },
    {
      "paths": ["infra/docker/notification-service.Dockerfile", "services/notification-service/**"],
      "targets": ["notification"]
    },
    {
      "paths": ["infra/docker/campus-service.Dockerfile", "services/campus-service/**"],
      "targets": ["campus"]
    },
    {
      "paths": ["infra/docker/iot-service.Dockerfile", "services/iot-service/**"],
      "targets": ["iot"]
    },
    {
      "paths": ["infra/docker/mongodb.Dockerfile", "infra/docker/mongodb-entrypoint.sh", "infra/docker/mongo-init.sh", "infra/docker/ensure-users.js"],
      "targets": ["mongodb"]
    },
    {
      "paths": ["packages/platform-auth/**"],
      "targets": ["platform", "notification", "backup", "campus", "iot"]
    },
    {
      "paths": ["packages/platform-browser-runtime/**"],
      "targets": ["platform"]
    }
  ]
}
