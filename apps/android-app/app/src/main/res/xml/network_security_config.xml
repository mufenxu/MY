<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">pxyb.cn</domain>
        <!-- 只固定中间/根 CA，叶子证书不参与固定（约 90 天轮换）。
             pxyb.cn 已由 Let's Encrypt 换成 TrustAsia LiteSSL，旧的 CA 级固定值随之全部失配，
             导致所有请求在 TLS 阶段被拒。expiration 是安全阀：到期后 pin 失配不再拦截。
             同一组 CA 也固定在 core/network 的 HttpClientProvider，换 CA 时必须同步两处。 -->
        <pin-set expiration="2027-04-01">
            <pin digest="SHA-256">Wt2ZC+IE3Cpf6hRflokHnxyZR+ZD82TqFkj1/fmYndc=</pin>
            <pin digest="SHA-256">ViiHLiRf5mFIuAut6snED2JS5kL6lZWuzks+ili4/UY=</pin>
        </pin-set>
    </domain-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">7n.pxyb.cn</domain>
        <!-- 与 pxyb.cn 同一组 CA，也必须带 expiration：本域承载更新清单 latest.json，
             一旦 CA 轮换而 pin 未同步，更新通道会先于业务接口失效，用户连补救的包都下不到。
             两个域的 pin 值与 core/network 的 HttpClientProvider 必须三方同步。 -->
        <pin-set expiration="2027-04-01">
            <pin digest="SHA-256">Wt2ZC+IE3Cpf6hRflokHnxyZR+ZD82TqFkj1/fmYndc=</pin>
            <pin digest="SHA-256">ViiHLiRf5mFIuAut6snED2JS5kL6lZWuzks+ili4/UY=</pin>
        </pin-set>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 蜜雪后台(mxwk.online)仅支持 HTTP，HTTPS 不可用，必须保留明文豁免。 -->
        <domain includeSubdomains="true">mxwk.online</domain>
        <!-- 重要：qlogo.cn 为 QQ/微信头像 CDN。蜜雪后台等外部页面写死 http://qlogo.cn 头像地址，
             移除本豁免会导致后台用户头像加载失败。除非这些站点全部改用 HTTPS，否则不要移除。 -->
        <domain includeSubdomains="true">qlogo.cn</domain>
    </domain-config>
</network-security-config>
