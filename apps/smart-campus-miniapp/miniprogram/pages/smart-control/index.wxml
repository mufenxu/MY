<view class="page">
  <!-- 顶部氛围区 -->
  <view class="hero">
    <view class="hero-glow hero-glow-a"></view>
    <view class="hero-glow hero-glow-b"></view>
    <view class="hero-top">
      <view class="hero-title">智能控制台</view>
      <view class="live-chip {{ sensorConnected ? 'live-on' : '' }}">
        <view class="live-dot"></view>
        <text>{{ sensorConnected ? '实时在线' : '连接中' }}</text>
      </view>
    </view>
    <view class="hero-sensors">
      <view class="hero-sensor">
        <text class="hero-sensor-label">温度</text>
        <view class="hero-sensor-value">
          {{ temperature }}<text class="hero-sensor-unit" wx:if="{{ sensorConnected && temperature !== '--' }}">°C</text>
        </view>
      </view>
      <view class="hero-sensor-divider"></view>
      <view class="hero-sensor">
        <text class="hero-sensor-label">湿度</text>
        <view class="hero-sensor-value">
          {{ humidity }}<text class="hero-sensor-unit" wx:if="{{ sensorConnected && humidity !== '--' }}">%</text>
        </view>
      </view>
    </view>
    <view class="hero-foot">
      <text class="hero-update" wx:if="{{ lastUpdated }}">最近同步 {{ lastUpdated }}</text>
      <view class="hero-status {{ sensorConnected ? 'ok' : '' }}" wx:if="{{ sensorStatus }}">{{ sensorStatus }}</view>
    </view>
    <view class="hero-error" wx:if="{{ sensorError }}">{{ sensorError }}</view>
  </view>

  <!-- 继电器 1：客厅 -->
  <view class="relay-card relay-primary {{ relayOn ? 'card-active' : '' }}">
    <view class="relay-card-head">
      <view class="relay-icon">
        <text>💡</text>
      </view>
      <view class="relay-meta">
        <view class="relay-title">客厅灯光</view>
        <view class="relay-sub">{{ statusText }}</view>
      </view>
      <view class="custom-switch {{ relayOn ? 'active' : '' }} {{ switching ? 'loading' : '' }}"
            bindtap="onSwitchTap"
            aria-role="switch"
            aria-label="客厅灯光"
            aria-checked="{{relayOn}}"
            aria-disabled="{{switching}}">
        <view class="switch-track" aria-hidden="true"></view>
        <view class="switch-thumb">
          <view class="loading-spinner" wx:if="{{switching}}"></view>
        </view>
      </view>
    </view>
    <view class="relay-card-foot">
      <view class="relay-status-row">
        <text class="relay-status-label">当前状态</text>
        <text class="relay-status-value {{ relayOn ? 'on' : 'off' }}">{{ relayStatusDisplay }}</text>
      </view>
      <text class="relay-desc">通过 MQTT 实时控制客厅线路开关</text>
    </view>
  </view>

  <!-- 继电器 2：阳台 -->
  <view class="relay-card relay-secondary {{ relay2On ? 'card-active' : '' }}">
    <view class="relay-card-head">
      <view class="relay-icon">
        <text>🔌</text>
      </view>
      <view class="relay-meta">
        <view class="relay-title">阳台插座</view>
        <view class="relay-sub">{{ statusText2 }}</view>
      </view>
      <view class="custom-switch {{ relay2On ? 'active' : '' }} {{ switching2 ? 'loading' : '' }}"
            bindtap="onSwitchTap2"
            aria-role="switch"
            aria-label="阳台插座"
            aria-checked="{{relay2On}}"
            aria-disabled="{{switching2}}">
        <view class="switch-track" aria-hidden="true"></view>
        <view class="switch-thumb">
          <view class="loading-spinner" wx:if="{{switching2}}"></view>
        </view>
      </view>
    </view>
    <view class="relay-card-foot">
      <view class="relay-status-row">
        <text class="relay-status-label">当前状态</text>
        <text class="relay-status-value {{ relay2On ? 'on' : 'off' }}">{{ relayStatusDisplay2 }}</text>
      </view>
      <view class="relay-status-row">
        <text class="relay-status-label">设备状态</text>
        <view class="device-pill {{ esp01sOnline ? 'device-online' : 'device-offline' }}">
          <view class="device-pill-dot"></view>
          <text>{{ esp01sOnline ? '在线' : '离线' }}</text>
        </view>
      </view>
      <text class="relay-desc">通过 ESP01S 模块实时控制阳台插座</text>
    </view>
  </view>

  <!-- 连接状态 -->
  <view class="status-card">
    <view class="status-card-head">
      <view class="relay-icon small">
        <text>📡</text>
      </view>
      <text class="status-card-title">连接状态</text>
    </view>
    <view class="status-grid">
      <view class="status-chip {{ mqttConnected ? 'chip-ok' : 'chip-bad' }}">
        <text class="chip-label">MQTT</text>
        <text class="chip-value">{{ mqttConnected ? '已连接' : '未连接' }}</text>
      </view>
      <view class="status-chip {{ subscribed ? 'chip-ok' : 'chip-bad' }}">
        <text class="chip-label">订阅</text>
        <text class="chip-value">{{ subscribed ? '已订阅' : '未订阅' }}</text>
      </view>
      <view class="status-chip {{ deviceOnline ? 'chip-ok' : 'chip-bad' }}">
        <text class="chip-label">主设备</text>
        <text class="chip-value">{{ deviceOnline ? '在线' : '离线' }}</text>
      </view>
    </view>
  </view>
</view>
