/* ========== 页面基调 ========== */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx 60rpx;
  background: linear-gradient(168deg, #eef2ff 0%, #f5f3ff 38%, #ecfeff 100%);
}

/* ========== 顶部氛围区 ========== */
.hero {
  position: relative;
  overflow: hidden;
  border-radius: 40rpx;
  padding: 40rpx 36rpx 30rpx;
  margin-bottom: 26rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 55%, #d946ef 120%);
  box-shadow: 0 18rpx 44rpx rgba(99, 102, 241, 0.35);
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(6rpx);
  opacity: 0.35;
  pointer-events: none;
}

.hero-glow-a {
  width: 260rpx;
  height: 260rpx;
  top: -110rpx;
  right: -70rpx;
  background: rgba(255, 255, 255, 0.9);
}

.hero-glow-b {
  width: 200rpx;
  height: 200rpx;
  bottom: -90rpx;
  left: -60rpx;
  background: rgba(34, 211, 238, 0.9);
}

.hero-top {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.live-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
}

.live-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fbbf24;
  animation: pulse 1.6s ease-in-out infinite;
}

.live-chip.live-on {
  background: rgba(255, 255, 255, 0.24);
  color: #ffffff;
}

.live-chip.live-on .live-dot {
  background: #4ade80;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.45; transform: scale(0.8); }
}

.hero-sensors {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 36rpx;
}

.hero-sensor {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hero-sensor-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.hero-sensor-value {
  margin-top: 8rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: baseline;
  line-height: 1;
}

.hero-sensor-unit {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
  margin-left: 6rpx;
}

.hero-sensor-divider {
  width: 2rpx;
  height: 84rpx;
  margin: 0 30rpx;
  background: rgba(255, 255, 255, 0.25);
}

.hero-foot {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
}

.hero-update {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.hero-status {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(251, 191, 36, 0.22);
  color: #fde68a;
}

.hero-status.ok {
  background: rgba(74, 222, 128, 0.22);
  color: #bbf7d0;
}

.hero-error {
  position: relative;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #fecaca;
  background: rgba(239, 68, 68, 0.18);
  border-radius: 18rpx;
  padding: 14rpx 20rpx;
  line-height: 1.5;
}

/* ========== 继电器卡片 ========== */
.relay-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 36rpx;
  padding: 32rpx 32rpx 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
  transition: box-shadow 0.3s ease;
}

.relay-primary.card-active {
  box-shadow: 0 16rpx 40rpx rgba(16, 185, 129, 0.2);
}

.relay-secondary.card-active {
  box-shadow: 0 16rpx 40rpx rgba(217, 70, 239, 0.2);
}

.relay-card-head {
  display: flex;
  align-items: center;
}

.relay-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.relay-secondary .relay-icon {
  background: linear-gradient(135deg, #fae8ff, #f5d0fe);
}

.relay-icon.small {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
}

.relay-meta {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.relay-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.relay-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.relay-card-foot {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #f1f5f9;
}

.relay-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.relay-status-row:last-of-type {
  margin-bottom: 0;
}

.relay-status-label {
  font-size: 24rpx;
  color: #94a3b8;
}

.relay-status-value {
  font-size: 26rpx;
  font-weight: 600;
}

.relay-status-value.on {
  color: #059669;
}

.relay-status-value.off {
  color: #94a3b8;
}

.relay-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #cbd5e1;
}

.device-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.device-pill-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.device-pill.device-online {
  background: #d1fae5;
  color: #059669;
}

.device-pill.device-online .device-pill-dot {
  background: #10b981;
  animation: pulse 1.8s ease-in-out infinite;
}

.device-pill.device-offline {
  background: #fee2e2;
  color: #dc2626;
}

.device-pill.device-offline .device-pill-dot {
  background: #ef4444;
}

/* ========== 自定义开关（渐变现代款） ========== */
.custom-switch {
  position: relative;
  width: 108rpx;
  height: 66rpx;
  border-radius: 999rpx;
  overflow: hidden;
  flex-shrink: 0;
  transition: opacity 0.25s ease;
}

.custom-switch:active {
  opacity: 0.8;
}

.custom-switch.loading {
  opacity: 0.75;
  pointer-events: none;
}

.switch-track {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #e2e8f0, #cbd5e1);
  transition: background 0.35s ease;
}

.relay-primary .custom-switch.active .switch-track {
  background: linear-gradient(135deg, #34d399, #10b981);
}

.relay-secondary .custom-switch.active .switch-track {
  background: linear-gradient(135deg, #e879f9, #d946ef);
}

.switch-thumb {
  position: absolute;
  top: 50%;
  left: 5rpx;
  width: 56rpx;
  height: 56rpx;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 4rpx rgba(15, 23, 42, 0.1), 0 4rpx 12rpx rgba(15, 23, 42, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(0, -50%);
  transition: transform 0.32s cubic-bezier(0.34, 1.4, 0.64, 1);
}

.custom-switch.active .switch-thumb {
  transform: translate(42rpx, -50%);
}

.loading-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #10b981;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

.relay-secondary .loading-spinner {
  border-top-color: #d946ef;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 连接状态 ========== */
.status-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 36rpx;
  padding: 28rpx 30rpx 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.status-card-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.status-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.status-grid {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.status-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 10rpx;
  border-radius: 24rpx;
  background: #f1f5f9;
}

.chip-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.chip-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
}

.status-chip.chip-ok {
  background: #ecfdf5;
}

.status-chip.chip-ok .chip-value {
  color: #059669;
}

.status-chip.chip-bad {
  background: #fef2f2;
}

.status-chip.chip-bad .chip-value {
  color: #dc2626;
}
