{
  "name": "@my-platform/campus-service",
  "version": "0.2.4",
  "private": true,
  "description": "Self-hosted read-only campus information workspace for HGU.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check-syntax.mjs",
    "lint": "eslint server.js public/app.js public/admin.js public/sms-login.js public/reservation-hub.js public/libroom-page.js public/libroom-records-page.js public/libroom-auto-page.js public/library-seat-page.js scripts src test",
    "test": "node --test",
    "verify": "npm run check && npm run lint && npm test",
    "upstream:check": "node scripts/check-upstream.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "env:setup": "node scripts/setup-env.mjs",
    "backup": "node scripts/backup.mjs",
    "user:list": "node scripts/users.mjs list",
    "user:add": "node scripts/users.mjs add",
    "user:password": "node scripts/users.mjs password",
    "migrate:sqlite": "node scripts/migrate-sqlite-to-mongodb.mjs",
    "cas:check": "node scripts/check-cas-page.mjs",
    "relay": "node scripts/school-relay.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@my-platform/platform-auth": "file:../../packages/platform-auth",
    "bwip-js": "^4.11.2",
    "cheerio": "^1.2.0",
    "mongodb": "^7.5.0",
    "qrcode": "^1.5.4",
    "sm-crypto": "^0.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
