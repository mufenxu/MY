WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_AGENT_ID=1000002
WECOM_SECRET=replace_with_wecom_application_secret
NOTIFY_API_KEY=replace_with_a_random_api_key
TOKEN_CACHE_MARGIN=120
# 中国移动新消息（5G 消息）通道，固定投递给 CMCC_RECIPIENT；两者留空即停用该通道。
CMCC_API_KEY=replace_with_cmcc_newmsg_api_key
CMCC_RECIPIENT=replace_with_11_digit_mobile_number
# 上行接收与指令自动回复默认开启；富媒体上传地址留空使用默认网关。
CMCC_RECEIVE_ENABLED=true
CMCC_REPLY_ENABLED=true
PORT=3000
